# .env.example
# Copy this file to .env and fill in the values accordingly.
# Never commit .env — it is ignored by backend/.gitignore.


# MongoDB server URI WITHOUT a database name — the app appends "/MediHub" itself
# (see src/db/dbConnection.js). Example: mongodb://127.0.0.1:27017
MONGODB_URI=""
# Port the API listens on. The frontend and dashboard expect 4000 (see their VITE_API_URL).
PORT="4000"

# Allowed browser origins for CORS (see app.js). Vite dev-server defaults shown.
FRONTEND_URL="http://localhost:5173"
DASHBOARD_URL="http://localhost:5174"

# Secret key for signing JWTs — use a long random value
JWT_SECRET_KEY=""
# Expiration time for JWTs (e.g., 1h, 1d)
JWT_EXPIRES="1d"
# Expiration time for cookies, in DAYS (utilis/jwtToken.js multiplies by 24*60*60*1000)
COOKIE_EXPIRE="1"

# Cloudinary cloud name
CLOUDINARY_CLOUD_NAME=""
# Cloudinary API key
CLOUDINARY_API_KEY=""
# Cloudinary API secret
CLOUDINARY_API_SECRET=""

# SMTP server host
SMTP_HOST=""
# SMTP server port
SMTP_PORT=""
# SMTP secure connection (true or false)
SMTP_SECURE=""
# SMTP account username
SMTP_USER=""
# SMTP account password
SMTP_PASSWORD=""

# Razorpay secret, read by payment.controller.js under this exact (misspelled) name
RAZORPAY_APT_SECRET=""
